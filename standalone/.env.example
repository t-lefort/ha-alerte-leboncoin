# --- Recherche ------------------------------------------------------------
# URL copiée depuis la barre d'adresse leboncoin, filtres déjà appliqués.
# Les paramètres de tracking (from, sa, page) sont retirés automatiquement.
LBC_SEARCH_URL="https://www.leboncoin.fr/recherche?text=apple+tv+4K&locations=Lyon__45.75_4.85_10000_50000&shippable=1&price=min-70&owner_type=all&sort=time&order=desc"

# --- Cadence --------------------------------------------------------------
# 90 s + jitter : détection en moins de 2 min, ~600 requêtes/jour.
# Descendre plus bas n'apporte rien et dégrade le profil de trafic.
POLL_SECONDS=90
POLL_JITTER_RATIO=0.25

# Plage de silence : le watcher ne poll pas du tout, et regroupe les annonces
# trouvées au réveil dans une notification non urgente.
QUIET_START_HOUR=23
QUIET_END_HOUR=8
TZ=Europe/Paris

# --- Notification ---------------------------------------------------------
# Webhook Home Assistant (chemin principal).
HA_WEBHOOK_URL=http://homeassistant.local:8123/api/webhook/CHANGE_ME_webhook_id

# Telegram direct : utilisé UNIQUEMENT si le webhook HA échoue, pour ne pas
# perdre l'alerte quand Home Assistant redémarre. Laisser vide pour désactiver.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Filtrage local -------------------------------------------------------
# La recherche plein texte de leboncoin est large : "apple tv 4K" remonte aussi
# des projecteurs, des clés HDMI et des ampoules connectées. Sans filtre, ces
# faux positifs déclenchent des notifications critiques et vous finirez par
# les désactiver.
#
# Virgule = alternatives (OU). Espace dans un terme = tous les mots exigés (ET).
#
# Mesuré sur une vraie réponse : 35 résultats -> 9 pertinents. REQUIRE écarte
# à lui seul les projecteurs, clés HDMI et ampoules connectées ; EXCLUDE cible
# les accessoires vendus seuls.
# Attention aux exclusions trop larges : "telecommande" écarterait aussi
# "Apple TV a1842 64 Go SANS télécommande", qui est une vraie annonce.
REQUIRE_KEYWORDS=apple tv,appletv
EXCLUDE_KEYWORDS=siri remote,apple remote,support,commutateur,splitter,repartiteur,housse,coque,cable hdmi,adaptateur secteur
# Chercher aussi dans le corps de l'annonce (plus permissif, plus de bruit).
FILTER_SEARCH_BODY=false

# --- Divers ---------------------------------------------------------------
DB_PATH=/data/seen.db
# Doit rester cohérent avec le warm-up que lbc envoie (cf. watcher/source.py).
# Mesuré : chrome_android 6/6 OK, safari_ios 0/6 avec cette librairie.
IMPERSONATE=chrome_android
MAX_ADS_PER_BATCH=10
# DRY_RUN=true : log les annonces trouvées sans rien envoyer (validation filtres)
DRY_RUN=false
